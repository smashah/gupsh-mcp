{
  "name": "@gupsh/mcp",
  "version": "0.1.0",
  "description": "Local MCP server for gupsh email marketing and analytics",
  "author": "IDK UNO LTD",
  "license": "MIT",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "gupsh-mcp": "build/index.js"
  },
  "files": [
    "build",
    "gupsh-mcp.mcpb",
    "NOTICE"
  ],
  "scripts": {
    "prebuild": "npm run sync:manifest",
    "build:js": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=esm --outfile=build/index.js --packages=external && chmod +x build/index.js",
    "build": "npm run build:js && npx -y @anthropic-ai/mcpb pack . gupsh-mcp.mcpb && node scripts/verify-mcpb-contents.mjs",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "lint": "biome lint .",
    "format": "biome format . --write",
    "sync:manifest": "node scripts/sync-manifest-version.mjs",
    "bundle": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "bento",
    "email",
    "marketing",
    "analytics",
    "ai",
    "claude",
    "cursor",
    "opencode"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smashah/gupsh-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/smashah/gupsh-mcp/issues"
  },
  "homepage": "https://github.com/smashah/gupsh-mcp",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@bentonow/bento-node-sdk": "2.0.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "zod": "^3.24.0"
  },
  "overrides": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@hono/node-server": "1.19.13",
    "hono": "4.12.18",
    "ajv": "8.18.0",
    "fast-uri": "3.1.2",
    "ip-address": "10.2.0",
    "path-to-regexp": "8.4.0",
    "qs": "6.14.2"
  },
  "resolutions": {
    "@modelcontextprotocol/sdk": "1.26.0",
    "@hono/node-server": "1.19.13",
    "hono": "4.12.18",
    "ajv": "8.18.0",
    "fast-uri": "3.1.2",
    "ip-address": "10.2.0",
    "path-to-regexp": "8.4.0",
    "qs": "6.14.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.2",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gupsh": {
    "upstream": "@bentonow/bento-mcp@1.3.3",
    "upstreamCommit": "212a9432433b3d6d55b85abcd7a89ac6f36ef788"
  }
}
